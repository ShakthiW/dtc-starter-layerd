# The droplet's shared Caddy (container layerd-caddy-1), see EDGE.md.
# HTTPS certificates for layerd are issued automatically once DNS points here.
# Upstreams are container names, which are unique across projects; plain service
# names like `backend` would be ambiguous on the shared networks.
{
	servers {
		# Cloudflare's addresses, so logs and apps see the visitor's IP for proxied sites
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# ---- LAYERD -------------------------------------------------------------------

layerd.lk {
	encode zstd gzip
	reverse_proxy layerd-storefront-1:8000
}

www.layerd.lk {
	redir https://layerd.lk{uri} permanent
}

# Medusa API and the admin dashboard (/app)
api.layerd.lk {
	encode zstd gzip
	reverse_proxy layerd-backend-1:9000
}

# ---- Other projects: one file each (neet.caddy, hydrokra.caddy, ...) ------------
import /etc/caddy/sites/*.caddy

# ---- Standord transport-only fail-closed ingress; owned include ------------------
# Managed by standord-bridge (its socket lives in the layerd_caddy_config volume).
# Keep this line exactly as it is.
import /config/standord-ingress/bridge-api.caddy
